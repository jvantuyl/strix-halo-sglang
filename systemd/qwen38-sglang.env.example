# Environment for qwen38-sglang.service; install as ~/.config/qwen38-sglang.env.
# Every variable is read by start-qwen38.sh (see its header for the full list);
# commented lines show the launcher's defaults. systemd EnvironmentFile syntax:
# no shell expansion, so write literal paths, not $HOME.

# Converted checkpoint (tools/convert_ple_fp8.py) and its PLE table directory.
# Each checkpoint needs its own PLE_DIR: the table file name is the same for all.
MODEL_DIR=/path/to/Qwen3.8-Flash-Next-AWQ-INT4-ple-fp8
PLE_DIR=/path/to/ple-cache

# Container and served model name; ExecStopPost removes ${SGLANG_CONTAINER}.
SGLANG_CONTAINER=sglang-qwen38
QWEN38_SERVED_NAME=qwen38-flash-next
#SGLANG_PORT=30001
#SGLANG_IMAGE=strix-halo-sglang:dev

# Largest decode CUDA graph; the request cap and the GDN state pool follow it
# (QWEN38_MAX_RUNNING_REQUESTS defaults to the same number, 5 mamba slots each).
QWEN38_CUDA_GRAPH_MAX_BS=16

# Extra sglang arguments, word-split by systemd. Speculative decoding (MTP)
# with the settings measured in docs/RUNNING_QWEN38.md; empty for plain graphs.
QWEN38_EXTRA_ARGS=--speculative-algorithm NEXTN --speculative-num-steps 3 --speculative-eagle-topk 1 --speculative-num-draft-tokens 4

# Server-wide chat-template defaults (a request's own chat_template_kwargs win):
# reasoning effort xhigh|medium|low (the template's own default is xhigh) and a
# one-line system prompt rendered before the client's. Empty disables either.
#QWEN38_REASONING_EFFORT=medium
#QWEN38_SYSTEM_PROMPT=If you are unsure or do not know something, say so plainly instead of guessing.
#QWEN38_CHAT_TEMPLATE=/path/to/strix-halo-sglang/configs/chat/qwen38.jinja

# Other launcher knobs, defaults shown.
#SGLANG_CONTEXT=131072
#QWEN38_KV_DTYPE=fp8_e4m3
#QWEN38_MAX_TOTAL_TOKENS=262144
#QWEN38_HOST_PARKED_PARAMS=embed_tokens.weight,visual.
#QWEN38_VISION=1
#MOE_CONFIG_DIR=/path/to/strix-halo-sglang/configs/moe/qwen38-flash-next
#SGLANG_TUNABLEOP_TUNING=0
#SGLANG_DOCKER_ARGS=
